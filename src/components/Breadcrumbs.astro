---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item) => (
        <li>
          {item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>
