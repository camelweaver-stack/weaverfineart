---
import Base from "../layouts/Base.astro";

const title = "Thank You | Weaver Fine Art";
const description = "Your note to Weaver Fine Art has been received.";
---

<Base title={title} description={description} noindex={true}>
  <div class="wrap">
    <header class="page-intro">
      <h1>Thank you</h1>
      <p>Your note is in. We read every submission and reply by email. A request does not reserve a work until we confirm.</p>
      <p><a class="button" href="/works/">Back to available works</a></p>
    </header>
  </div>
</Base>
